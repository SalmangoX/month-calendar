<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/it_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="3dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <TextView android:id="@+id/it_bar" android:layout_width="3.5dp" android:layout_height="28dp"
        android:background="@drawable/bar_p0" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginLeft="8dp" android:orientation="vertical">
        <TextView android:id="@+id/it_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13.5dp" android:textColor="@color/w_text" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/it_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11dp" android:textColor="@color/w_text2" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
