    <!-- 月历小组件的色条底色：浅色是实色；深色在 values-night 里是专门设计的深色调，和应用一致 -->
    <color name="chip_p3">#D4472C</color>
    <color name="chip_p2">#C98A1E</color>
    <color name="chip_p1">#5B8FD0</color>
    <color name="chip_p0">#A3A1AD</color>

    <!-- 今天格子的淡主色底（浅色 12%、深色 20%，和应用里选中日期一致） -->
    <color name="w_today">#1F4F80C4</color>

    <!-- 品牌渐变（今天的日期、今天放不下的小标签）：明亮的金黄 → 天蓝 → 亮蓝，和网页 brand 变量一致 -->
    <color name="brand_a">#E2B562</color>
    <color name="brand_mid">#74A8E6</color>
