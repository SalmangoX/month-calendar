    <color name="red">#D9453E</color>
    <!-- p4 / p4_soft：已取消的绿色优先级。仓库里如果还有 drawable/*_p4.xml，这两行要留着，否则 APK 编译失败 -->
    <color name="p4">#41B08F</color>
    <!-- 已完成或不在本月的事件：同色的淡底 -->
    <color name="p3_soft">#40D4472C</color>
    <color name="p2_soft">#40C98A1E</color>
    <color name="p1_soft">#405B8FD0</color>
